"""Run a workflow under Memray and generate reusable memory reports."""

import argparse
import subprocess
import sys
from pathlib import Path


def run_command(command: list[str]) -> None:
    print("$", " ".join(command))
    subprocess.run(command, check=True)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Profile a workflow and generate Memray reports."
    )
    parser.add_argument(
        "workflow",
        choices=("notebook2", "notebook3", "notebook4"),
        help="Workflow runner to profile.",
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=Path("memory_profiles"),
        help="Directory for Memray reports.",
    )
    parser.add_argument(
        "--label",
        help="Optional report label; defaults to the workflow name.",
    )
    parser.add_argument(
        "--arrow-backend",
        action="store_true",
        help="Use the PyArrow-backed loader for Notebook 2 or Notebook 3.",
    )
    parser.add_argument(
        "--input",
        type=Path,
        help="Alternative preprocessed input for Notebook 4.",
    )
    parser.add_argument(
        "--preprocessed-output",
        type=Path,
        help="Alternative preprocessed output for Notebook 3.",
    )
    args = parser.parse_args()

    if args.workflow == "notebook4" and args.arrow_backend:
        parser.error("--arrow-backend is only valid for notebook2 or notebook3")
    if args.workflow != "notebook4" and args.input is not None:
        parser.error("--input is only valid for notebook4")
    if args.workflow != "notebook3" and args.preprocessed_output is not None:
        parser.error("--preprocessed-output is only valid for notebook3")

    args.output_dir.mkdir(parents=True, exist_ok=True)
    label = args.label or args.workflow
    binary = args.output_dir / f"{label}.bin"
    stats = args.output_dir / f"{label}_stats.txt"
    tree = args.output_dir / f"{label}_tree.txt"
    flamegraph = args.output_dir / f"{label}.html"

    workflow_command = [
        sys.executable,
        "-m",
        f"scripts.run_{args.workflow}",
    ]
    if args.arrow_backend:
        workflow_command.append("--arrow-backend")
    if args.input is not None:
        workflow_command.extend(["--input", str(args.input)])
    if args.preprocessed_output is not None:
        workflow_command.extend(["--output", str(args.preprocessed_output)])

    run_command(
        [
            sys.executable,
            "-m",
            "memray",
            "run",
            "-o",
            str(binary),
            *workflow_command,
        ]
    )
    run_command(
        [
            sys.executable,
            "-m",
            "memray",
            "stats",
            str(binary),
            "-o",
            str(stats),
        ]
    )
    run_command(
        [
            sys.executable,
            "-m",
            "memray",
            "tree",
            str(binary),
            "-o",
            str(tree),
        ]
    )
    run_command(
        [
            sys.executable,
            "-m",
            "memray",
            "flamegraph",
            str(binary),
            "-o",
            str(flamegraph),
        ]
    )
    print(f"Memory reports written to {args.output_dir}")


if __name__ == "__main__":
    main()
